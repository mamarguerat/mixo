{
  "name": "Mixo",
  "version": "0.0.8",
  "description": "Routing tool for behringer x32 based on hardware availabilities instead of software capabilities. Aim to simplify routing and create automatic documentation.",
  "main": "src/js/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mamarguerat/mixo.git"
  },
  "publish": {
    "provider": "github",
    "releaseType": "release"
  },
  "keywords": [
    "routing",
    "mixer",
    "midas",
    "behringer",
    "x32",
    "x32-mixer",
    "m32"
  ],
  "author": "Martin Marguerat",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/mamarguerat/mixo/issues"
  },
  "homepage": "https://github.com/mamarguerat/mixo#readme",
  "devDependencies": {
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "about-window": "^1.15.2",
    "electron-updater": "^6.8.9",
    "jquery": "^3.7.1",
    "jquery-sortablejs": "^1.0.1"
  },
  "build": {
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ],
    "appId": "ch.martinmarguerat.mixo",
    "productName": "Mixo",
    "mac": {
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "icon": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "win": {
      "publish": "github"
    }
  }
}
